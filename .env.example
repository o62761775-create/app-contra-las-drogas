# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO (PLANTILLA)
# Plataforma: Videojuegos contra las Drogas
# Copia este archivo como '.env' para desarrollo local: cp .env.example .env
# IMPORTANTE: Nunca subas el archivo '.env' real al repositorio ni expongas claves.
# ==============================================================================

# Puerto en el que se ejecutará el servidor HTTP de Express
PORT=3000

# Entorno de ejecución de la aplicación (development | production | test)
NODE_ENV=development

# Clave secreta de autenticación para la API de OpenAI (ChatGPT)
# Se consume única y exclusivamente desde el backend (servidor Node.js).
# NUNCA debe exponerse al frontend ni a clientes web.
OPENAI_API_KEY=tu_api_key_aqui
